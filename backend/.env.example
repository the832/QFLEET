# Copy to backend/.env and fill in from the Neon Console.
# Connect > connection string (pooled is fine)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Settings > Better Auth > Auth URL (leave empty to run without sign-in)
NEON_AUTH_URL=https://ep-xxxx.neonauth.REGION.aws.neon.tech/neondb/auth
# Optional: run the QAOA circuit on a real IBM quantum computer (free IBM Quantum account)
# quantum.cloud.ibm.com > API key; instance CRN is optional
IBM_QUANTUM_TOKEN=
IBM_QUANTUM_INSTANCE=
# Split hosting: the Vercel site(s) allowed to call this API, and optionally a regex for preview URLs
ALLOWED_ORIGINS=
ALLOWED_ORIGIN_REGEX=
